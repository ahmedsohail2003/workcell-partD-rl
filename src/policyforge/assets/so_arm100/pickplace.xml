<mujoco model="sim2cell_pickplace">
  <!-- SO-ARM100 pick-and-place work-cell: arm + block + tray on a worktable.
       Lives next to so_arm100.xml (Menagerie convention) so mesh paths resolve. -->
  <include file="so_arm100.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <global offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="2d" name="worktable" builtin="checker" mark="edge" rgb1="0.55 0.57 0.60" rgb2="0.50 0.52 0.55"
      markrgb="0.4 0.4 0.42" width="300" height="300"/>
    <material name="worktable" texture="worktable" texuniform="true" texrepeat="8 8" reflectance="0.05"/>
    <material name="block_red" rgba="0.85 0.15 0.12 1"/>
    <material name="tray_blue" rgba="0.20 0.35 0.65 1"/>
  </asset>

  <worldbody>
    <light name="toplight" pos="0.3 -0.3 1.2" dir="-0.25 0.25 -1" directional="true" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" size="1 1 0.05" type="plane" material="worktable" friction="0.8 0.005 0.0001"/>

    <!-- Pick object: small cube (freejoint) -->
    <body name="block" pos="0.0 -0.22 0.012">
      <freejoint name="block_free"/>
      <geom name="block_geom" type="box" size="0.012 0.012 0.012" material="block_red" mass="0.02"
        friction="1.2 0.005 0.0001" solimp="2 1 0.01" solref="0.01 1"/>
    </body>

    <!-- Place target: shallow tray -->
    <body name="tray" pos="-0.18 -0.13 0">
      <geom name="tray_floor" type="box" size="0.045 0.045 0.003" pos="0 0 0.003" material="tray_blue"/>
      <geom name="tray_wall_n" type="box" size="0.045 0.004 0.012" pos="0 0.041 0.012" material="tray_blue"/>
      <geom name="tray_wall_s" type="box" size="0.045 0.004 0.012" pos="0 -0.041 0.012" material="tray_blue"/>
      <geom name="tray_wall_e" type="box" size="0.004 0.045 0.012" pos="0.041 0 0.012" material="tray_blue"/>
      <geom name="tray_wall_w" type="box" size="0.004 0.045 0.012" pos="-0.041 0 0.012" material="tray_blue"/>
    </body>

    <!-- Fixed observation camera (front of workspace) -->
    <camera name="front" pos="0.0 -0.55 0.35" xyaxes="1 0 0 0 0.55 0.85" fovy="52"/>
    <!-- Diagnostic overview camera -->
    <camera name="overview" pos="0.6 -0.6 0.5" xyaxes="0.7 0.7 0 -0.4 0.4 0.85" fovy="55"/>
  </worldbody>
</mujoco>
